#!/usr/bin/env sh

echo "🔍 Pre-commit: Checking for resume.md changes..."

# Check if resume.md was modified
if git diff --cached --name-only | grep -q "resume.md"; then
  echo "📝 resume.md changed, regenerating resume data and PDF..."
  
  # Parse resume to JSON
  npm run parse-resume
  
  # Generate PDF if pandoc is available
  if command -v pandoc >/dev/null 2>&1; then
    echo "📄 Generating PDF..."
    npm run generate-resume-pdf
    
    # Stage the generated files
    git add src/data/resume-data.json
    git add public/resume.pdf
    
    echo "✅ Resume data and PDF updated and staged"
  else
    echo "⚠️  Warning: pandoc not installed, skipping PDF generation"
    echo "   Install with: brew install pandoc basictex (macOS)"
    echo "   The JSON data has been generated and staged."
    
    # Still stage the JSON
    git add src/data/resume-data.json
  fi
else
  echo "✅ No resume.md changes, skipping generation"
fi

echo "🔍 Pre-commit: Checking for blog changes..."

if git diff --cached --name-only | grep -q "^blogs/"; then
  echo "📝 Blog files changed, regenerating blogs and sitemap..."
  npm run generate-blogs
  npm run generate-sitemap
  git add src/data/blogs.json
  git add public/sitemap.xml
  echo "✅ blogs.json and sitemap.xml updated and staged"
else
  echo "✅ No blog changes, skipping generation"
fi
